{
  "name": "subtitle-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/core-mt": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^6.2.1",
    "@remotion/bundler": "^4.0.375",
    "@remotion/cli": "^4.0.375",
    "@remotion/compositor-linux-x64-gnu": "^4.0.376",
    "@remotion/renderer": "^4.0.375",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/multer": "^2.0.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.63.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.3",
    "electron-is-dev": "^3.0.1",
    "emoji-picker-react": "^4.16.1",
    "express": "^5.1.0",
    "fabric": "^6.7.1",
    "form-data": "^4.0.5",
    "framer-motion": "^12.23.12",
    "html2canvas": "^1.4.1",
    "immer": "^10.1.3",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "lucide-react": "^0.548.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hotkeys-hook": "^5.1.0",
    "react-player": "^2.16.0",
    "remotion": "^4.0.375",
    "tailwindcss": "^3.4.17",
    "tree-kill": "^1.2.2",
    "use-debounce": "^10.0.6",
    "uuid": "^13.0.0",
    "wavesurfer.js": "^7.10.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/fabric": "^5.3.10",
    "@types/html2canvas": "^0.5.35",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prisma": "^6.2.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.subtitle.studio",
    "productName": "Subtitle Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/default-avatar.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/default-avatar.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/default-avatar.png"
    }
  }
}
