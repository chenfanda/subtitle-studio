# 后端运行端口
PORT=8000

# 内部 ASR 服务的真实地址 (加密/隐藏的核心)
INTERNAL_ASR_URL=http://localhost:8008/transcribe

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 数据库配置 (PostgreSQL)
DATABASE_URL=postgresql://admin:admin123@localhost:5432/subtitle_studio?schema=public
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=subtitle_studio
POSTGRES_PORT=5432

# 认证配置
JWT_SECRET=super-secret-key-change-this-in-production
JWT_REFRESH_SECRET=another-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# 服务商配置 (aliyun | tencent | mock)
AUTH_PROVIDER=mock

# 阿里云配置
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# 腾讯云配置
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

# 开发环境配置
DEV_MODE=true